# Database connection path or URL (defaults to adaptive_content.db)
DATABASE_URL=adaptive_content.db

# AI Provider ("mock" or "gemini")
AI_PROVIDER=mock

# Gemini configuration (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
# Models: gemini-2.5-flash-lite (fast/cost-efficient) or gemini-2.5-flash (editorial/reasoning)
GEMINI_MODEL=gemini-2.5-flash-lite

# Legacy AI API Key (backward compat)
AI_API_KEY=

# Application Environment ("development", "production", "test")
ENVIRONMENT=development
